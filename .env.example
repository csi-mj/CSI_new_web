# Copy this file to .env.local and fill in the values.
# Get all three from: Supabase Dashboard -> Project Settings -> API
# NEVER commit .env.local — only this example file goes in git.

# Project URL (e.g. https://abcdefghijk.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" key — safe to expose in the browser, used for Google login
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — SECRET, server-only, bypasses row-level security
SUPABASE_SERVICE_ROLE_KEY=


BREVO_API_KEY =

# n8n WhatsApp webhook (fired after successful event registration).
# Leave blank to use the built-in club webhook; fill in only to override.
CSI_WEBHOOK_URL=
CSI_WEBHOOK_USERNAME=
CSI_WEBHOOK_PASSWORD=